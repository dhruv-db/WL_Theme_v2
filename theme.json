  "customStyles": [
    {
      "cssRef": "theme.css",
      "classRef": "sense-theme"
    }
  ],
  "fontFamily": "@AvenirLtLight",
  "color": "@TextColor",
  "fontSize": "@TextSize",
  "backgroundColor": "@BackgroundColor",
  "dataColors": {
    "primaryColor": "#232942",
    "othersColor": "#bcc2db",
    "errorColor": "#CC4000",
    "nullColor": "#CCCCCC"
  },
  "sheet": {
    "title": {
      "color": "@ColourWLWhite",
      "private":{
        "titleBackgroundColor":"@ColourWLWhite",
        "titleBackgroundGradientColor":"@ColourWLRedMid",
        "color": "@ColourWLBlack"
    },
      "approved":{
        "titleBackgroundColor":"@ColourWLWhite",
        "titleBackgroundGradientColor":"@ColourWLRedMid",
        "color": "@ColourWLBlack"
    },
      "published":{
        "titleBackgroundColor":"@ColourWLWhite",
        "titleBackgroundGradientColor":"@ColourWLRed",
        "color": "@ColourWLBlack"
    }
  }
 }	,
