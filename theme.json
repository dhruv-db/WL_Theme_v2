{
  "_inherit": true,
  "_variables": {
    "@TitleSize": "16px",
    "@SubtitleSize": "15px",
    "@TextSize": "12px",
    "@FooterSize": "10px",
    "@TitleColor": "#000050",
    "@SubtitleColor": "#45557b",
